DATA_DIR=data/ml-latest-small-filtered
SEARCH_MAX_FEATURES=30000
SEARCH_CANDIDATE_POOL=100
RECOMMENDATION_NEIGHBOR_COUNT=30
RECOMMENDATION_MINIMUM_OVERLAP=3
RECOMMENDATION_OVERLAP_SHRINKAGE=10
RECOMMENDATION_PREDICTION_SHRINKAGE=5
RECOMMENDATION_DEFAULT_TOP_K=5
RECOMMENDATION_QUERY_WEIGHT=0.45
RECOMMENDATION_PROFILE_WEIGHT=0.20
RECOMMENDATION_COLLABORATIVE_WEIGHT=0.20
RECOMMENDATION_QUALITY_WEIGHT=0.15
RECOMMENDATION_GENERAL_PROFILE_WEIGHT=0.20
RECOMMENDATION_GENERAL_COLLABORATIVE_WEIGHT=0.50
RECOMMENDATION_GENERAL_QUALITY_WEIGHT=0.30
# none | openai | openai-compatible | gemini | anthropic | groq | bedrock
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
